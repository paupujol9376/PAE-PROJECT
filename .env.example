# Copy to .env and fill in. Never commit .env.
# Keys are issued by Giga (https://maps.giga.global) after registering for API access.
GIGA_SCHOOL_LOCATION_API_KEY=''
GIGA_COUNTRY_API_KEY=''

# --- Alerts (server side only: server/.env on the machine that runs server/index.js) ---
# Never put these in the app or in any VITE_* variable: VITE_* values are public.
TWILIO_ACCOUNT_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_FROM_NUMBER=''
# Shared secret the server expects in the Authorization header (Bearer). Demo only.
ALERTS_API_TOKEN=''

# --- App build (public, safe to expose) ---
# mock = alerts stay on the device (default); sms = send through the server below.
VITE_ALERTS_MODE='mock'
VITE_ALERTS_API_URL=''
# Optional weather proxy (server/index.js /api/weather/*): one download for every user.
VITE_WEATHER_PROXY_URL=''
