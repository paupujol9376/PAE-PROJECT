# --- Secrets ---
.env
.env.*
!.env.example

# --- Heavy / generated geodata (regenerate with pipeline/, see README) ---
*.pbf
*.osm.pbf
*.pmtiles
*.mbtiles
*.geojsonseq
*.geojson.gz
# root data dir (pipeline inputs/outputs) and the copy served by the app;
# NOT any folder named data (app/src/data is source code)
/data/
app/public/data/
# map label glyphs are small, OFL-licensed app assets: keep them
!app/public/glyphs/**/*.pbf
pipeline/bin/
pipeline/cache/
*.jar

# --- Node / build ---
node_modules/
dist/
dev-dist/
.vite/
coverage/
playwright-report/
test-results/
*.log

# --- Temporary screenshots / captures ---
tmp/
screenshots-tmp/
*.tmp.png
replica/**/_tmp/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# --- Claude Code local state ---
.claude/settings.local.json
.claude/worktrees/

# --- Python ---
__pycache__/
*.pyc

# --- Reference screenshots of third-party apps (recon only, never shipped) ---
replica/01-recon/screens/
